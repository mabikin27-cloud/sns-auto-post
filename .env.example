# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Gemini API
GEMINI_API_KEY=

# Google スプレッドシート
SPREADSHEET_ID=

# Google サービスアカウント（ローカルはファイルパス、Render 等では JSON をそのまま貼り付け可能）
# 例: ./service_account.json
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
# または本番用に JSON を 1 行で設定（GOOGLE_APPLICATION_CREDENTIALS より優先）
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
